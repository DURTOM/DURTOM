{
  "manifest_version": 3,
  "name": "Bidcom Precios",
  "version": "1.4",
  "description": "Extrae SKU, precio normal y precio rebajado de Bidcom y actualiza WooCommerce.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bidcom.com.ar/*",
    "https://bidcom.com.ar/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Bidcom Precios"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
